SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-client-key
CARTO_API_KEY=your-carto-api-key
# Server-side only. Never expose this to Flutter or any client app.
GEMINI_API_KEY=your-server-only-gemini-key
# Current free-tier default used by the backend AI orchestration.
# This alias resolves to Gemini 3.5 Flash Lite and supports function calling.
GEMINI_MODEL=gemini-flash-lite-latest
# Local development only; release builds require an HTTPS endpoint.
TRANSIT_API_URL=http://127.0.0.1:8080
